# ===========================================
# Database
# ===========================================
# PostgreSQL connection string
# For Railway: Use the DATABASE_URL provided by Railway
# For Render: Use the Internal Database URL
# For local: postgresql://user:password@localhost:5432/blindtest_party
DATABASE_URL="postgresql://user:password@localhost:5432/blindtest_party"

# ===========================================
# Authentication
# ===========================================
# JWT secret for access tokens (generate a strong random string)
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# JWT secret for refresh tokens
JWT_REFRESH_SECRET="your-refresh-token-secret"

# ===========================================
# Server
# ===========================================
# Port (Railway/Render will set this automatically)
PORT=4000

# Environment
NODE_ENV=development

# Frontend URL (for CORS)
# For production, set to your Vercel URL
CLIENT_URL=http://localhost:3000

# ===========================================
# Redis (optional - for caching and sessions)
# ===========================================
# REDIS_URL="redis://localhost:6379"
