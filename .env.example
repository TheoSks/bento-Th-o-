# Database (Required)
# Use Vercel Postgres, Neon, or Supabase
DATABASE_URL="postgresql://user:password@host:5432/bento"

# NextAuth v5 (Required)
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-key-here"

# Production URL (set automatically by Vercel)
# NEXTAUTH_URL="https://your-app.vercel.app"

# OAuth Providers (Optional)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Twitter/X OAuth (optional)
AUTH_TWITTER_ID=""
AUTH_TWITTER_SECRET=""

# Storage (optional - choose one)
# Vercel Blob
BLOB_READ_WRITE_TOKEN=""

# OR AWS S3
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""
AWS_REGION=""

# Analytics (optional)
POSTHOG_KEY=""
